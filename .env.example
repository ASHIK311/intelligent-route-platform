# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Security
JWT_SECRET=super-secret-intelligent-route-jwt-token-key-2026
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_TYPE=sqlite
DATABASE_URL=file:./dev.sqlite
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/route_platform?schema=public

# Redis Cache (Optional, in-memory cache used when absent)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Client Configuration
CLIENT_URL=http://localhost:5173

# ML Prediction Service Configuration
ML_SERVICE_URL=http://localhost:5000
USE_EMBEDDED_ML=true

# External Provider Configurations (Mock / Standard abstraction)
MAP_PROVIDER=osm
TRAFFIC_PROVIDER=simulated
WEATHER_PROVIDER=simulated
