{
  "name": "intelligent-route-platform",
  "version": "1.0.0",
  "description": "Intelligent Adaptive Route Optimization & Personal Route Intelligence Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "benchmark": "npm run benchmark --workspace=packages/routing-engine",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "route-optimization",
    "a-star",
    "dijkstra",
    "machine-learning",
    "personal-route-brain",
    "intelligent-routing"
  ],
  "author": "Antigravity Intelligent Systems",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
